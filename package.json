{
  "name": "capnweb-shell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bidirectional remote shells for Linux, macOS and Windows.",
  "bin": {
    "cns": "src/cli.ts"
  },
  "scripts": {
    "build": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --define CAPNWEB_COMPILED=true --outfile dist/cns src/cli.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "start": "bun src/cli.ts",
    "listen": "bun src/cli.ts listen",
    "connect": "bun src/cli.ts connect",
    "test": "bun test --timeout 30000 ./src",
    "test:compiled": "bun run build && CAPNWEB_TEST_BINARY=1 bun test --timeout 30000 ./src"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "capnweb": "0.12.0",
    "commander": "14.0.3",
    "tree-kill": "1.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "7.0.2",
    "execa": "10.2.1"
  },
  "packageManager": "bun@1.4.2"
}
